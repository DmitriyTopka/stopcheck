    "keeper": "tsx src/keeper.ts"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.32.1",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0"
  }
}
